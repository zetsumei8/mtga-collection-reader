-            if owned is None or quantity_confidence < 0.50:
-                review_reasons.append("owned quantity was not read confidently")
-            records.append(
-                VisualCardRead(
-                    name=name,
-                    quantity=owned,
-                    confidence=confidence,
-                    name_confidence=name_confidence,
-                    quantity_confidence=quantity_confidence,
-                    raw_text=" | ".join(value for value in (raw_name, raw_quantity) if value),
-                    tile_hash=int(tile_hashes[index]),
-                    page_number=page_number,
-                    crop_path=crop_paths[index],
-                    set_code=set_code,
-                    collector_number=collector_number,
-                    needs_review=bool(review_reasons),
-                    review_reason="; ".join(review_reasons),
-                )
-            )
-
-        return PageRecognitionResult(
-            records=records,
-            unowned_skipped=unowned_skipped,
-            quantity_uncertain=quantity_uncertain,
-            cache_hits=cache_hits,
-            batch_ocr_runs=batch_runs,
-            fallback_ocr_runs=fallback_runs,
-            duration_seconds=time.monotonic() - started,
-        )
