-class VisualCollectionAccumulator:
-    """Deduplicate overlapping tiles while preserving distinct printings/art."""
-
-    def __init__(self) -> None:
-        self.confirmed: List[VisualCardRead] = []
-        self.uncertain: List[VisualCardRead] = []
-
-    @staticmethod
-    def _same_named_card(left: VisualCardRead, right: VisualCardRead) -> bool:
-        left_name = normalize_card_text(left.name)
-        right_name = normalize_card_text(right.name)
-        # A confident name mismatch overrides a coincidental visual hash match.
-        if left_name and right_name and left_name != right_name:
-            return False
-        return fingerprints_match(left.tile_hash, right.tile_hash)
-
-    def add(self, record: VisualCardRead) -> bool:
-        for index, existing in enumerate(self.confirmed):
-            if self._same_named_card(existing, record):
-                return False
-        for index, existing in enumerate(self.uncertain):
-            if not self._same_named_card(existing, record):
-                continue
-            if existing.needs_review and not record.needs_review:
-                # A later clean read of an overlapping tile supersedes the earlier
-                # uncertain read instead of leaving a duplicate review item.
-                self.uncertain.pop(index)
-                self.confirmed.append(record)
-                return True
-            return False
-
-        if record.needs_review:
-            self.uncertain.append(record)
-        else:
-            self.confirmed.append(record)
-        return True
-
-    def confirmed_copy_count(self) -> int:
-        return sum(
-            int(record.quantity)
-            for record in self.confirmed
-            if record.quantity is not None and record.quantity > 0
-        )
-
-    def discovered_card_count(self) -> int:
-        return len(self.confirmed) + len(self.uncertain)
