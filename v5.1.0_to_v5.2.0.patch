-def capture_quality(frame: Any) -> float:
-    """Score a frame; blank/black/protected captures receive a very low score."""
-    if np is None or cv2 is None or frame is None or getattr(frame, "size", 0) == 0:
-        return -1.0
-    if frame.ndim != 3 or frame.shape[0] < 200 or frame.shape[1] < 300:
-        return -1.0
-    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
-    mean = float(gray.mean())
-    variance = float(gray.var())
-    edges = cv2.Canny(gray, 60, 160)
-    edge_density = float(np.count_nonzero(edges)) / float(edges.size)
-    if mean < 2.0 or mean > 253.0 or variance < 4.0 or edge_density < 0.001:
-        return -1.0
-    return variance + edge_density * 1500.0
