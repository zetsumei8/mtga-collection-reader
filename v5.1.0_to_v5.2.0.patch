-def _process_image_name(pid: int) -> str:
-    """Return the executable basename for a Windows process without requiring admin."""
-    if os.name != "nt" or pid <= 0:
-        return ""
-    try:
-        kernel32 = ctypes.windll.kernel32
-        open_process = kernel32.OpenProcess
-        open_process.argtypes = [ctypes.c_ulong, ctypes.c_int, ctypes.c_ulong]
-        open_process.restype = ctypes.c_void_p
-        query_name = kernel32.QueryFullProcessImageNameW
-        query_name.argtypes = [
-            ctypes.c_void_p,
-            ctypes.c_ulong,
-            ctypes.c_wchar_p,
-            ctypes.POINTER(ctypes.c_ulong),
-        ]
-        query_name.restype = ctypes.c_int
-        close_handle = kernel32.CloseHandle
-        close_handle.argtypes = [ctypes.c_void_p]
-        close_handle.restype = ctypes.c_int
-
-        # PROCESS_QUERY_LIMITED_INFORMATION works across normal user processes
-        # and is enough for QueryFullProcessImageNameW.
-        handle = open_process(0x1000, 0, int(pid))
-        if not handle:
-            return ""
-        try:
-            capacity = 32768
-            buffer = ctypes.create_unicode_buffer(capacity)
-            length = ctypes.c_ulong(capacity)
-            if query_name(handle, 0, buffer, ctypes.byref(length)):
-                return Path(buffer.value).name
-        finally:
-            close_handle(handle)
-    except Exception:
-        return ""
-    return ""
