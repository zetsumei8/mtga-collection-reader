-def choose_log_file(path: Path) -> Path:
-    """Resolve either a selected log file or a folder containing Arena logs."""
-    path = Path(path).expanduser()
-    if path.is_file():
-        return path
-    if not path.is_dir():
-        raise PlayerLogError(f"Player.log location does not exist: {path}")
-
-    preferred_names = ("Player.log", "Player-prev.log", "output_log.txt")
-    candidates: List[Path] = []
-    for name in preferred_names:
-        candidate = path / name
-        if candidate.is_file():
-            candidates.append(candidate)
-    for pattern in ("*.log", "*.txt"):
-        candidates.extend(
-            item for item in path.glob(pattern) if item.is_file() and item not in candidates
-        )
-    if not candidates:
-        raise PlayerLogError(f"No Player.log, .log, or .txt log file was found in {path}")
-    return max(candidates, key=lambda item: item.stat().st_mtime)
