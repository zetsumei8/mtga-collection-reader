-def _dhash(image: Any) -> int:
-    if cv2 is None or np is None or image is None or getattr(image, "size", 0) == 0:
-        return 0
-    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY) if image.ndim == 3 else image
-    gray = cv2.GaussianBlur(gray, (7, 7), 0)
-    resized = cv2.resize(gray, (9, 8), interpolation=cv2.INTER_AREA)
-    differences = resized[:, 1:] > resized[:, :-1]
-    value = 0
-    for bit in differences.flatten():
-        value = (value << 1) | int(bool(bit))
-    return int(value)
-
-
-def hamming_distance(a: int, b: int) -> int:
-    return int((int(a) ^ int(b)).bit_count())
-
-
-def tile_fingerprint(frame: Any, rect: Rect) -> int:
-    """Build a tolerant title + artwork + color fingerprint for one card tile."""
-    x1, y1, x2, y2 = rect
-    margin_x = max(1, int((x2 - x1) * 0.03))
-    margin_y = max(1, int((y2 - y1) * 0.03))
-    crop = frame[y1 + margin_y : y2 - margin_y, x1 + margin_x : x2 - margin_x]
-    if crop is None or crop.size == 0:
-        return 0
-
-    height = crop.shape[0]
-    title_crop = crop[: max(8, int(height * 0.22)), :]
-    art_crop = crop[int(height * 0.18) : max(int(height * 0.72), int(height * 0.18) + 8), :]
-    title_hash = _dhash(title_crop)
-    art_hash = _dhash(art_crop)
-
-    hsv = cv2.cvtColor(art_crop, cv2.COLOR_BGR2HSV)
-    small = cv2.resize(hsv, (4, 4), interpolation=cv2.INTER_AREA)
-    color_hash = 0
-    for hue, saturation, value in small.reshape(-1, 3):
-        hq = min(15, int(hue) * 16 // 180)
-        sq = min(3, int(saturation) * 4 // 256)
-        vq = min(3, int(value) * 4 // 256)
-        # Gray coding keeps adjacent quantization buckets close in Hamming space.
-        h_gray = hq ^ (hq >> 1)
-        s_gray = sq ^ (sq >> 1)
-        v_gray = vq ^ (vq >> 1)
-        block = (h_gray << 4) | (s_gray << 2) | v_gray
-        color_hash = (color_hash << 8) | int(block)
-    return (int(title_hash) << 192) | (int(art_hash) << 128) | int(color_hash)
-
-
-def _fingerprint_segments(value: int) -> Tuple[int, int, int]:
-    mask64 = (1 << 64) - 1
-    mask128 = (1 << 128) - 1
-    title = (int(value) >> 192) & mask64
-    art = (int(value) >> 128) & mask64
-    color = int(value) & mask128
-    return title, art, color
-
-
-def fingerprints_match(a: int, b: int) -> bool:
-    """Match the same card through hover/foil changes without merging new art."""
-    a_title, a_art, a_color = _fingerprint_segments(a)
-    b_title, b_art, b_color = _fingerprint_segments(b)
-    title_distance = hamming_distance(a_title, b_title)
-    art_distance = hamming_distance(a_art, b_art)
-    color_distance = hamming_distance(a_color, b_color)
-
-    # Normal stable capture: all components remain close.
-    if title_distance <= 8 and art_distance <= 10 and color_distance <= 16:
-        return True
-    # Foil/color animation may alter color heavily while title and artwork edges stay.
-    # Only relax the color requirement when both artwork hashes contain useful
-    # structure; flat/low-detail tiles must still agree in color.
-    art_informative = (8 <= a_art.bit_count() <= 56 and 8 <= b_art.bit_count() <= 56)
-    if title_distance <= 8 and art_distance <= 14 and (color_distance <= 24 or art_informative):
-        return True
-    # A hover treatment may brighten the artwork but leaves the title especially stable.
-    if title_distance <= 5 and art_distance <= 20 and color_distance <= 42 and art_informative:
-        return True
-    return False
-
-
-def fingerprint_matches(a: Sequence[int], b: Sequence[int]) -> List[Tuple[int, int]]:
-    """Return one-to-one matching tile indices from current sequence a to prior b."""
-    if not a or not b:
-        return []
-    used: set[int] = set()
-    matches: List[Tuple[int, int]] = []
-    for first_index, first in enumerate(a):
-        best_index = -1
-        best_score = 10_000
-        for second_index, second in enumerate(b):
-            if second_index in used or not fingerprints_match(first, second):
-                continue
-            first_segments = _fingerprint_segments(first)
-            second_segments = _fingerprint_segments(second)
-            score = sum(
-                hamming_distance(left, right)
-                for left, right in zip(first_segments, second_segments)
-            )
-            if score < best_score:
-                best_score = score
-                best_index = second_index
-        if best_index >= 0:
-            used.add(best_index)
-            matches.append((first_index, best_index))
-    return matches
-
-
-def fingerprint_similarity(a: Sequence[int], b: Sequence[int]) -> float:
-    return len(fingerprint_matches(a, b)) / max(1, len(a), len(b))
-
-
-def dominant_index_shift(matches: Sequence[Tuple[int, int]]) -> Tuple[int, int]:
-    """Return the dominant current-minus-previous tile index shift and support."""
-    counts: Dict[int, int] = {}
-    for current_index, previous_index in matches:
-        delta = current_index - previous_index
-        counts[delta] = counts.get(delta, 0) + 1
-    if not counts:
-        return 0, 0
-    return max(counts.items(), key=lambda item: item[1])
-
