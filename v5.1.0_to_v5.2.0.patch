-def arena_window_match_score(title: str, process_name: str, class_name: str = "") -> int:
-    """Score a top-level window as MTG Arena.
-
-    Borderless Arena commonly reports the title ``MTGA`` or no useful title at
-    all, so process identity is the primary signal. This helper is intentionally
-    platform-neutral so it can be regression-tested without Windows.
-    """
-    title_key = (title or "").strip().casefold()
