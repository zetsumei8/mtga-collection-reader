-        self._initialize_backends()
-        self._select_best_backend()
-
-    def _initialize_backends(self) -> None:
-        try:
-            import mss  # type: ignore
-
-            self._mss = mss.mss()
-            self._backends.append("MSS desktop capture")
-        except Exception:
-            self._mss = None
-
-        try:
-            import dxcam  # type: ignore
-
-            self._dxcam = dxcam.create(output_color="BGR")
-            self._backends.append("DXGI desktop duplication")
-        except Exception:
-            self._dxcam = None
-
-        try:
-            from PIL import ImageGrab  # type: ignore
-
-            self._pil_grab = ImageGrab
-            self._backends.append("Windows image capture")
-        except Exception:
-            self._pil_grab = None
-
-        if not self._backends:
-            raise VisualScanError("No screen-capture backend is available. Run install.bat again.")
-
-    def _capture_backend(self, backend: str) -> Any:
-        self.target = refresh_window_target(self.target)
-        left, top, right, bottom = self.target.rect
-        if right <= left or bottom <= top:
-            raise VisualScanError("MTG Arena has an invalid client size.")
-
-        if backend == "MSS desktop capture" and self._mss is not None:
-            shot = self._mss.grab(
-                {"left": left, "top": top, "width": right - left, "height": bottom - top}
-            )
-            return np.asarray(shot, dtype=np.uint8)[:, :, :3].copy()
-
-        if backend == "DXGI desktop duplication" and self._dxcam is not None:
-            # DXcam normally returns None when no *new* desktop frame has been
-            # presented. A still collection screen is valid input, so request
-            # the latest frame even when it has not changed. Older DXcam builds
-            # do not expose this keyword; retain a compatibility fallback.
-            try:
-                frame = self._dxcam.grab(
-                    region=(left, top, right, bottom), new_frame_only=False
-                )
-            except TypeError:
-                frame = self._dxcam.grab(region=(left, top, right, bottom))
-            if frame is None:
-                raise VisualScanError("DXGI returned an empty frame.")
-            return np.asarray(frame, dtype=np.uint8).copy()
-
-        if backend == "Windows image capture" and self._pil_grab is not None:
-            image = self._pil_grab.grab(bbox=(left, top, right, bottom), all_screens=True)
-            rgb = np.asarray(image.convert("RGB"), dtype=np.uint8)
-            return cv2.cvtColor(rgb, cv2.COLOR_RGB2BGR)
-
-        raise VisualScanError(f"Capture backend unavailable: {backend}")
-
-    def _select_best_backend(self) -> None:
-        scores: List[Tuple[float, str]] = []
-        errors: List[str] = []
-        for backend in self._backends:
-            samples: List[float] = []
-            try:
-                for _ in range(2):
-                    frame = self._capture_backend(backend)
-                    samples.append(capture_quality(frame))
-                    time.sleep(0.08)
-                scores.append((max(samples), backend))
-            except Exception as exc:
-                errors.append(f"{backend}: {exc}")
-        viable = [item for item in scores if item[0] >= 0]
-        if not viable:
-            detail = "; ".join(errors) if errors else "all captures were blank"
