-def estimate_scroll_progress(frame: Any) -> Optional[float]:
-    """Estimate custom scrollbar thumb position when a strong vertical track exists."""
-    if cv2 is None or np is None or frame is None:
-        return None
-    height, width = frame.shape[:2]
-    strip = frame[int(height * 0.10) : int(height * 0.94), int(width * 0.965) : int(width * 0.997)]
-    if strip.size == 0:
-        return None
-    gray = cv2.cvtColor(strip, cv2.COLOR_BGR2GRAY)
-    column_profile = np.mean(gray, axis=1)
-    smoothed = np.convolve(column_profile, np.ones(9) / 9.0, mode="same")
-    baseline = float(np.median(smoothed))
-    deviation = np.abs(smoothed - baseline)
-    threshold = max(12.0, float(np.percentile(deviation, 90)))
-    mask = deviation >= threshold
-    runs: List[Tuple[int, int]] = []
-    start: Optional[int] = None
-    for index, active in enumerate(mask):
-        if active and start is None:
-            start = index
-        elif not active and start is not None:
-            if index - start >= max(10, int(len(mask) * 0.025)):
-                runs.append((start, index))
-            start = None
-    if start is not None and len(mask) - start >= max(10, int(len(mask) * 0.025)):
-        runs.append((start, len(mask)))
-    if not runs:
-        return None
-    thumb = max(runs, key=lambda run: run[1] - run[0])
-    thumb_length = thumb[1] - thumb[0]
-    if thumb_length > len(mask) * 0.55:
-        return None
-    center = (thumb[0] + thumb[1]) / 2.0
-    travel = max(1.0, len(mask) - thumb_length)
-    progress = (center - thumb_length / 2.0) / travel
-    if not -0.05 <= progress <= 1.05:
-        return None
-    return max(0.0, min(1.0, float(progress)))
-
