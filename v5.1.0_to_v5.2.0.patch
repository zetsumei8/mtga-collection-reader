-            joined = " ".join(text for text, _score in items[:4])
-            candidate_phrases.append(
-                (joined, sum(score for _text, score in items[:4]) / min(4, len(items)))
-            )
-
-        for raw, ocr_score in candidate_phrases:
-            normalized = normalize_card_text(raw)
-            if len(normalized) < 3:
-                continue
-            if normalized in self.normalized_to_name:
-                confidence = 0.62 + 0.38 * max(0.0, min(1.0, float(ocr_score)))
-                if confidence > best_confidence:
-                    best_confidence = confidence
-                    best_name = self.normalized_to_name[normalized]
-                    best_raw = raw
-                continue
-            match = self.process.extractOne(
-                normalized,
-                self.normalized_names,
-                scorer=self.fuzz.WRatio,
-                score_cutoff=58,
-            )
-            if not match:
-                continue
-            matched_normalized, fuzzy_score, _index = match
-            confidence = 0.38 * max(0.0, min(1.0, ocr_score)) + 0.62 * (float(fuzzy_score) / 100.0)
-            if confidence > best_confidence:
-                best_confidence = confidence
-                best_name = self.normalized_to_name[matched_normalized]
