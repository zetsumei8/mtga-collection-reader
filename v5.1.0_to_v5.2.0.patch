-def _read_log_tail(path: Path, max_bytes: int = 128 * 1024 * 1024) -> Tuple[str, int, int]:
-    size = path.stat().st_size
-    start = max(0, size - max_bytes)
-    with path.open("rb") as handle:
-        handle.seek(start)
-        data = handle.read()
-    # UTF-8 is the normal format. ``replace`` makes a single damaged line unable
-    # to prevent recovery of a later valid collection payload.
-    return data.decode("utf-8-sig", errors="replace"), start, len(data)
