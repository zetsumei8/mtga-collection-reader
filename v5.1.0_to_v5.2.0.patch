-    def recognize_page(
-        self,
-        frame: Any,
-        rects: Sequence[Rect],
-        tile_hashes: Sequence[int],
-        page_number: int,
-        crop_paths: Sequence[str],
-    ) -> PageRecognitionResult:
-        started = time.monotonic()
-        before_calls = self.ocr_calls
-        quantity_reads: Dict[int, Tuple[Optional[int], float, str]] = {}
-        candidates: List[int] = []
-        unowned_skipped = 0
-        quantity_uncertain = 0
