-    def _run_single_title_fallback(self, image: Any) -> List[Tuple[str, float]]:
-        if image is None or getattr(image, "size", 0) == 0:
-            return []
-        original, enhanced = self._enhanced_title_pair(image)
-        gray = cv2.cvtColor(enhanced, cv2.COLOR_BGR2GRAY)
-        threshold = cv2.adaptiveThreshold(
-            gray, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C, cv2.THRESH_BINARY, 31, 7
-        )
-        threshold_bgr = cv2.cvtColor(threshold, cv2.COLOR_GRAY2BGR)
-        height = max(original.shape[0], enhanced.shape[0], threshold_bgr.shape[0])
-        width = original.shape[1] + enhanced.shape[1] + threshold_bgr.shape[1] + 24
-        panel = np.full((height, width, 3), 18, dtype=np.uint8)
-        cursor = 0
-        for variant in (original, enhanced, threshold_bgr):
-            panel[: variant.shape[0], cursor : cursor + variant.shape[1]] = variant
-            cursor += variant.shape[1] + 12
-        try:
-            detections = self._ocr_detections(self._engine_call(panel))
-        except Exception:
-            return []
-        best: Dict[str, float] = {}
-        for detection in detections:
-            text = detection.text.strip()
-            if text:
-                best[text] = max(best.get(text, 0.0), detection.score)
-        return sorted(best.items(), key=lambda item: item[1], reverse=True)
