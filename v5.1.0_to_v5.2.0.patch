-class CardGridDetector:
-    """Detect repeated Magic-card rectangles without assuming a fixed resolution."""
-
-    def __init__(self, minimum_cards: int = 4) -> None:
-        self.minimum_cards = minimum_cards
-        self.last_rects: List[Rect] = []
-
-    @staticmethod
-    def _iou(a: Rect, b: Rect) -> float:
-        ax1, ay1, ax2, ay2 = a
-        bx1, by1, bx2, by2 = b
-        ix1, iy1 = max(ax1, bx1), max(ay1, by1)
-        ix2, iy2 = min(ax2, bx2), min(ay2, by2)
-        if ix2 <= ix1 or iy2 <= iy1:
-            return 0.0
-        intersection = (ix2 - ix1) * (iy2 - iy1)
-        union = (ax2 - ax1) * (ay2 - ay1) + (bx2 - bx1) * (by2 - by1) - intersection
-        return intersection / max(1.0, float(union))
-
-    def _nms(self, rects: Sequence[Rect]) -> List[Rect]:
-        ordered = sorted(rects, key=lambda r: (r[2] - r[0]) * (r[3] - r[1]), reverse=True)
-        kept: List[Rect] = []
-        for rect in ordered:
-            if all(self._iou(rect, existing) < 0.55 for existing in kept):
-                kept.append(rect)
-        return kept
-
-    def detect(self, frame: Any) -> List[Rect]:
-        if cv2 is None or np is None or frame is None:
-            return []
-        height, width = frame.shape[:2]
-        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
-        gray = cv2.GaussianBlur(gray, (5, 5), 0)
-        edges = cv2.Canny(gray, 45, 135)
-        kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (5, 5))
-        closed = cv2.morphologyEx(edges, cv2.MORPH_CLOSE, kernel, iterations=2)
-        contours, _hierarchy = cv2.findContours(closed, cv2.RETR_LIST, cv2.CHAIN_APPROX_SIMPLE)
-
-        candidates: List[Rect] = []
-        min_w, max_w = width * 0.065, width * 0.28
-        min_h, max_h = height * 0.16, height * 0.58
-        for contour in contours:
-            x, y, w, h = cv2.boundingRect(contour)
-            if not (min_w <= w <= max_w and min_h <= h <= max_h):
-                continue
-            aspect = h / max(1.0, float(w))
-            if not 1.15 <= aspect <= 1.72:
-                continue
-            if y < height * 0.07 or y + h > height * 0.99:
-                continue
-            contour_area = cv2.contourArea(contour)
-            fill = contour_area / max(1.0, float(w * h))
-            if fill < 0.18:
-                continue
-            candidates.append((x, y, x + w, y + h))
-
-        candidates = self._nms(candidates)
-        if len(candidates) >= self.minimum_cards:
-            widths = np.array([r[2] - r[0] for r in candidates], dtype=float)
-            heights = np.array([r[3] - r[1] for r in candidates], dtype=float)
-            median_w, median_h = float(np.median(widths)), float(np.median(heights))
-            candidates = [
-                r
-                for r in candidates
-                if 0.68 * median_w <= r[2] - r[0] <= 1.32 * median_w
-                and 0.68 * median_h <= r[3] - r[1] <= 1.32 * median_h
-            ]
-
-        candidates.sort(key=lambda r: (round(r[1] / max(1, int(height * 0.08))), r[0]))
-        if len(candidates) >= self.minimum_cards:
-            self.last_rects = candidates
-            return candidates
-
-        # Never reuse stale card geometry on a different screen. A missed frame is
-        # safer to ignore than to OCR an overlay or another Arena menu as cards.
-        return []
-
