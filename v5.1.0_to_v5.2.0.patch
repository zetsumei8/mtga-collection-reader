-
-    contours, _hierarchy = cv2.findContours(geometry, cv2.RETR_LIST, cv2.CHAIN_APPROX_SIMPLE)
-    min_w = max(3, int(card_width * 0.018))
-    max_w = max(min_w + 2, int(card_width * 0.115))
-    min_h = max(3, int(card_height * 0.012))
-    max_h = max(min_h + 2, int(card_height * 0.10))
-    card_top_in_region = y1 - top
-
-    raw_candidates: List[Tuple[float, float, float, float, float]] = []
