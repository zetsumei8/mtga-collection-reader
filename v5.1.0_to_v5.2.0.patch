-COLLECTION_MARKER = re.compile(
-    r"(?:PlayerInventory\.)?GetPlayerCards(?:V\d+)?|"
-    r"PlayerCards|player[_ ]?cards",
-    re.IGNORECASE,
-)
-# Matches both normal JSON ("123": 4) and one-level escaped JSON (\"123\": 4).
-NUMERIC_PAIR = re.compile(r'(?:\\?")(?P<id>\d{3,10})(?:\\?")\s*:\s*(?P<qty>\d{1,3})')
