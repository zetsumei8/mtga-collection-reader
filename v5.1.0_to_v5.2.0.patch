-        try:
-            detections = self._ocr_detections(self._engine_call(sheet))
-        except Exception:
-            return {}, 1
-
-        by_row: Dict[int, List[Tuple[str, float]]] = {index: [] for index, _rect in indexed_rects}
-        for detection in detections:
-            if detection.bounds is None:
-                continue
-            center_y = (detection.bounds[1] + detection.bounds[3]) / 2.0
-            for index, (top, bottom) in row_ranges.items():
-                if top - 3 <= center_y <= bottom + 3:
