-        # Quantity first: a confidently empty four-diamond row means the tile is
-        # unowned and does not need any OCR at all.
-        for index, rect in enumerate(rects):
-            quantity, confidence, raw = detect_owned_pips(frame, rect)
-            if quantity == 0:
-                if confidence >= self.ZERO_SKIP_CONFIDENCE:
-                    quantity_reads[index] = (quantity, confidence, raw)
-                    unowned_skipped += 1
-                    continue
-                # A weak zero read is dangerous because silently skipping it
-                # could lose an owned card. Route it to review as uncertain.
-                quantity_reads[index] = (None, 0.0, raw or "low-confidence zero-copy read")
-                quantity_uncertain += 1
-                candidates.append(index)
-                continue
-            quantity_reads[index] = (quantity, confidence, raw)
-            if quantity is None:
-                quantity_uncertain += 1
-            candidates.append(index)
-
-        name_reads: Dict[int, Tuple[str, float, str]] = {}
-        pending: List[Tuple[int, Rect]] = []
-        cache_hits = 0
-        for index in candidates:
-            fingerprint = int(tile_hashes[index])
-            cached = self.title_cache.get(fingerprint)
-            if cached is not None:
-                name_reads[index] = cached
-                cache_hits += 1
-            else:
-                pending.append((index, rects[index]))
-
-        batch_reads, batch_runs = self._batch_match_names(frame, pending)
-        name_reads.update(batch_reads)
-        fallback_runs = 0
-        for index, _rect in pending:
-            current = name_reads.get(index, ("", 0.0, ""))
-            if current[0] and current[1] >= self.MIN_NAME_CONFIDENCE:
-                self.title_cache[int(tile_hashes[index])] = current
-                continue
-            fallback_items = self._run_single_title_fallback(self._title_crop(frame, rects[index]))
-            fallback_runs += 1
-            fallback = self._match_name(fallback_items)
-            if fallback[1] > current[1]:
-                current = fallback
-                name_reads[index] = current
-            if current[0] and current[1] >= 0.72:
-                self.title_cache[int(tile_hashes[index])] = current
-
-        records: List[VisualCardRead] = []
-        for index in candidates:
-            name, name_confidence, raw_name = name_reads.get(index, ("", 0.0, ""))
-            owned, quantity_confidence, raw_quantity = quantity_reads[index]
-            set_code, collector_number = self._printing_for_name(name)
-            confidence = min(name_confidence, quantity_confidence if owned is not None else 0.0)
-            review_reasons: List[str] = []
