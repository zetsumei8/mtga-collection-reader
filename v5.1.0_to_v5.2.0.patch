-class GlobalStopHotkey:
-    """Register F8 as a Windows-wide stop signal without a third-party hook."""
-
-    WM_HOTKEY = 0x0312
-    WM_QUIT = 0x0012
-    MOD_NOREPEAT = 0x4000
-    VK_F8 = 0x77
-
-    def __init__(self, stop_event: threading.Event) -> None:
-        self.stop_event = stop_event
-        self.thread: Optional[threading.Thread] = None
-        self.thread_id = 0
-        self.registered = False
-
-    def start(self) -> None:
-        if os.name != "nt":
-            return
-
-        def run() -> None:
-            self.thread_id = ctypes.windll.kernel32.GetCurrentThreadId()
-            self.registered = bool(
-                ctypes.windll.user32.RegisterHotKey(None, 1, self.MOD_NOREPEAT, self.VK_F8)
-            )
-            if not self.registered:
-                return
-            message = ctypes.wintypes.MSG()  # type: ignore[attr-defined]
-            while ctypes.windll.user32.GetMessageW(ctypes.byref(message), None, 0, 0) > 0:
-                if message.message == self.WM_HOTKEY:
-                    self.stop_event.set()
-                    break
-            ctypes.windll.user32.UnregisterHotKey(None, 1)
-
-        import ctypes.wintypes  # noqa: F401
-
-        self.thread = threading.Thread(target=run, daemon=True)
-        self.thread.start()
-
-    def close(self) -> None:
-        if os.name == "nt" and self.thread_id:
-            try:
-                ctypes.windll.user32.PostThreadMessageW(self.thread_id, self.WM_QUIT, 0, 0)
-            except Exception:
-                pass
-        if self.thread:
-            self.thread.join(timeout=0.5)
