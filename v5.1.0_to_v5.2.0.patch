-            if self._failure_count >= 2:
-                self._select_best_backend()
-                self._failure_count = 0
-                frame = self._capture_backend(self.backend_name)
-        else:
-            self._failure_count = 0
-        if capture_quality(frame) < 0:
-            raise VisualScanError(
-                "Arena capture became blank or obstructed. Keep Arena visible and use Windowed or "
-                "Borderless Windowed mode."
-            )
-        return CaptureResult(frame=frame, backend=self.backend_name, rect=self.target.rect)
