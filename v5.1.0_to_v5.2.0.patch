-    @staticmethod
-    def rows(records: Sequence[VisualCardRead]) -> List[Dict[str, Any]]:
-        """Return one persistent observation per visible card tile.
-
-        The accumulator already removes overlapping duplicates. Keeping the tile
-        fingerprint here prevents two visually distinct printings with the same
-        name from being collapsed when set/collector data is not visible.
-        """
-        rows: List[Dict[str, Any]] = []
-        for record in records:
-            if not record.name or record.quantity is None or record.quantity < 1:
-                continue
-            rows.append(
-                {
-                    "count": int(record.quantity),
-                    "quantity": int(record.quantity),
-                    "name": record.name,
-                    "set": record.set_code,
-                    "set_code": record.set_code,
-                    "cn": record.collector_number,
-                    "collector_number": record.collector_number,
-                    "fingerprint": str(record.tile_hash),
