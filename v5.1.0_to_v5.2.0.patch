-        enable_windows_dpi_awareness()
-        self.preferred_hwnd = int(preferred_hwnd) if preferred_hwnd else None
-        self.target = find_mtga_window(self.preferred_hwnd)
-        self.backend_name = ""
-        self._mss = None
-        self._dxcam = None
-        self._pil_grab = None
