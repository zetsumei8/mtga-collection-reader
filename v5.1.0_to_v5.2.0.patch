-def _json_values(text: str, start: int, end: int, limit: int = 220) -> Iterator[Tuple[int, Any]]:
-    """Yield decodable JSON values embedded in log prefixes or surrounding text."""
-    decoder = json.JSONDecoder()
-    count = 0
-    position = max(0, start)
-    end = min(len(text), end)
-    while position < end and count < limit:
